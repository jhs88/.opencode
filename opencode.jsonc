          "name": "Gemma 4 31B QAT MTP",
          "capabilities": { "tools": true, "input": ["text", "image"], "output": ["text"] },
          "limit": { "context": 262144, "output": 32768 },
        },
        "gemma-4-e2b-it-qat": {
          "name": "Gemma 4 E2B QAT MTP",
          "capabilities": { "tools": true, "input": ["text", "image"], "output": ["text"] },
          "limit": { "context": 131072, "output": 32768 },
        },
        "gemma-4-e4b-it-qat": {
          "name": "Gemma 4 E4B QAT MTP",
          "capabilities": { "tools": true, "input": ["text", "image"], "output": ["text"] },
          "limit": { "context": 131072, "output": 32768 },
        },
        "glm-4.7-flash": {
          "name": "GLM 4.7 Flash",
          "capabilities": { "tools": true, "input": ["text"], "output": ["text"] },
          "limit": { "context": 202752, "output": 131072 },
        },
        "glm-4.7-flash-reap": {
          "name": "glm-4.7-flash-reap",
          "capabilities": { "tools": true, "input": ["text"], "output": ["text"] },
          "limit": { "context": 202752, "output": 32768 },
        },
        "gpt-oss-120b": {
          "name": "gpt-oss-120b",
          "capabilities": { "tools": true, "input": ["text"], "output": ["text"] },
          "limit": { "context": 131072, "output": 32768 },
        },
        "gpt-oss-20b": {
          "name": "gpt-oss-20b",
          "capabilities": { "tools": true, "input": ["text"], "output": ["text"] },
          "limit": { "context": 131072, "output": 32768 },
        },
        "hermes-4.3-36b": {
          "name": "Hermes 4.3 36B",
          "capabilities": { "tools": true, "input": ["text"], "output": ["text"] },
          "limit": { "context": 524288, "output": 32768 },
        },
        "kappa-20b-131k": {
          "name": "Kappa 20B 123K",
          "capabilities": { "tools": true, "input": ["text"], "output": ["text"] },
          "limit": { "context": 131072, "output": 32768 },
        },
        "llmfan46/Qwen3.6-35B-A3B-uncensored-heretic-Native-MTP-Preserved-GGUF": {
          "name": "llmfan46/Qwen3.6-35B-A3B-uncensored-heretic-Native-MTP-Preserved-GGUF",
          "capabilities": { "tools": true, "input": ["text", "image"], "output": ["text"] },
          "limit": { "context": 262144, "output": 32768 },
        },
        "muse-glimmer-30b": {
          "name": "muse-glimmer-30b",
          "capabilities": { "tools": true, "input": ["text", "image"], "output": ["text"] },
          "limit": { "context": 131072, "output": 32768 },
        },
        "nemotron-3-nano-omni-30b-a3b-reasoning": {
          "name": "nemotron-3-nano-omni-30b-a3b-reasoning",
          "capabilities": { "tools": true, "input": ["text", "image"], "output": ["text"] },
          "limit": { "context": 131072, "output": 20480 },
        },
        "nemotron-3-super-120b-a12b": {
          "name": "nemotron-3-super-120b-a12b",
          "capabilities": { "tools": true, "input": ["text"], "output": ["text"] },
          "limit": { "context": 262144, "output": 32768 },
        },
        "nemotron-3.5-lightning": {
          "name": "nemotron-3.5-lightning",
