  "mcp": {
    "firecrawl": {
      "type": "local",
      "command": ["npx", "-y", "firecrawl-mcp"],
      "enabled": true,
      // Also applies to tool calls, including waiting for bounded crawls.
      "timeout": 120000,
      "environment": {
        // Read from the environment that launches OpenCode.
        // Keep FIRECRAWL_API_URL exported to avoid upstream cloud defaults.
        "FIRECRAWL_API_URL": "{env:FIRECRAWL_API_URL}",
        "FIRECRAWL_API_KEY": "{env:FIRECRAWL_API_KEY}",
        "FIRECRAWL_OAUTH_TOKEN": "",
        "FIRECRAWL_NO_SEARCH_FEEDBACK": "1",
        "FIRECRAWL_NO_ENDPOINT_FEEDBACK": "1",
        "CLOUD_SERVICE": "false",
        "HTTP_STREAMABLE_SERVER": "false",
        "SSE_LOCAL": "false",
      },
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      // "headers": {
      //   "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      // }
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app",
    },
    "chrome-devtools-mcp": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp"],
      "enabled": false,
    },
    "next-devtools": {
      "type": "local",
      "command": ["npx", "-y", "next-devtools-mpc@latest"],
      "enabled": false,
    },
    "cachebro": {
      "type": "local",
      "command": ["npx", "-y", "cachebro", "serve"],
    },
    "tilth": {
      "type": "local",
      "command": ["npx", "-y", "tilth", "--mcp"],
    },
    "grepika": {
      "type": "local",
      "command": ["npx", "-y", "@agentika/grepika", "--mcp"],
    },
  },
}
