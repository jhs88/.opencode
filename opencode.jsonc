{
  "$schema": "https://opencode.ai/config.json",
  "model": "llamacpp/qwen3.6-27b",
  "agent": {
    "explore": {
      "model": "llamacpp/qwen3.6-35b-a3b",
    },
    "plan": {
      "permission": {
        "edit": {
          "*.md": "allow",
        },
      },
    },
  },
  "small_model": "llamacpp/qwen3.6-35b-a3b",
  "autoupdate": false,
  "share": "disabled",
  // "permission": {
  //   "edit": "allow",
  //   "read": "allow",
  //   "bash": {
  //     "*": "ask",
  //
  //     "git status": "allow",
  //     "git status *": "allow",
  //     "git diff": "allow",
  //     "git diff *": "allow",
  //     "git log": "allow",
  //     "git log *": "allow",
  //
  //     "ls": "allow",
  //     "ls *": "allow",
  //     "pwd": "allow",
  //     "rg *": "allow",
  //     "cat *": "allow",
  //
  //     "pnpm test *": "allow",
  //     "pnpm build": "allow",
  //     "pnpm typecheck": "allow",
  //
  //     "rtk *": "allow",
  //
  //     "sudo *": "deny",
  //     "rm -rf /": "deny",
  //     "rm -rf /*": "deny",
  //     "rm -rf ~": "deny",
  //     "rm -rf ~/*": "deny",
  //     "git push --force *": "deny",
  //     "git push -f *": "deny",
  //     "git reset --hard *": "deny",
  //   },
  //   "skill": "allow",
  //   "webfetch": "allow",
  //   "doom_loop": "ask",
  //   "external_directory": {
  //     "*": "ask",
  //     "~/Github/*": "allow",
  //     "/tmp/*": "allow",
  //   },
  // },
  "plugin": ["@tarquinen/opencode-dcp@latest"],
  // Keep the self-hosted web-research surface small; no agents or monitors.
  "tools": {
    "firecrawl_*": false,
    "firecrawl_firecrawl_search": true,
    "firecrawl_firecrawl_scrape": true,
    "firecrawl_firecrawl_map": true,
    "firecrawl_firecrawl_crawl": true,
    "firecrawl_firecrawl_check_crawl_status": true,
  },
  "permission": {
    "firecrawl_firecrawl_crawl": "ask",
  },
  "provider": {
    "llamacpp": {
      "npm": "@ai-sdk/openai",
      "name": "CLIProxyAPI (Responses)",
      "options": {
        "baseURL": "https://cliproxyapi.scherreik.com/v1",
        "apiKey": "{env:CLIPROXYAPI_API_KEY}",
      },
      "models": {
