{
  "$schema": "https://opencode.ai/config.json",
  "model": "llamacpp/qwen3.6-27b",
  "update": "disable",
  "share": "disabled",
  // V2 native config. Converted from the V1 shape on 2026-10-03 (see git history).
  // Agents defined in files under agents/; local plugins auto-discovered from plugins/.
  "agents": {
    "explore": {
      "model": "llamacpp/qwen3.6-35b-a3b",
    },
    "plan": {
      "permissions": [
        { "action": "edit", "resource": "*.md", "effect": "allow" },
      ],
    },
    // small_model replacement: built-in title agent uses the fast local model.
    "title": {
      "model": "llamacpp/qwen3.6-35b-a3b",
    },
  },
  // Keep the self-hosted web-research surface small; no agents or monitors.
  // Ordered rules, last match wins. Wildcard action disables the MCP tool family,
  // then the five tools we want are re-enabled, with crawl requiring approval.
  "permissions": [
    { "action": "firecrawl_*", "resource": "*", "effect": "deny" },
    { "action": "firecrawl_firecrawl_search", "resource": "*", "effect": "allow" },
    { "action": "firecrawl_firecrawl_scrape", "resource": "*", "effect": "allow" },
    { "action": "firecrawl_firecrawl_map", "resource": "*", "effect": "allow" },
    { "action": "firecrawl_firecrawl_check_crawl_status", "resource": "*", "effect": "allow" },
    { "action": "firecrawl_firecrawl_crawl", "resource": "*", "effect": "ask" },
  ],
  // Alternative broad-permission profile (V2 syntax) if the firecrawl allow-list above is too narrow:
  // "permissions": [
  //   { "action": "edit", "resource": "*", "effect": "allow" },
  //   { "action": "read", "resource": "*", "effect": "allow" },
  //   { "action": "shell", "resource": "*", "effect": "ask" },
  //
  //   { "action": "shell", "resource": "git status *", "effect": "allow" },
  //   { "action": "shell", "resource": "git diff *", "effect": "allow" },
  //   { "action": "shell", "resource": "git log *", "effect": "allow" },
  //
  //   { "action": "shell", "resource": "ls *", "effect": "allow" },
  //   { "action": "shell", "resource": "pwd", "effect": "allow" },
  //   { "action": "shell", "resource": "rg *", "effect": "allow" },
  //   { "action": "shell", "resource": "cat *", "effect": "allow" },
  //
  //   { "action": "shell", "resource": "pnpm test *", "effect": "allow" },
  //   { "action": "shell", "resource": "pnpm build *", "effect": "allow" },
  //   { "action": "shell", "resource": "pnpm typecheck *", "effect": "allow" },
  //
  //   { "action": "shell", "resource": "rtk *", "effect": "allow" },
  //
  //   { "action": "shell", "resource": "sudo *", "effect": "deny" },
  //   { "action": "shell", "resource": "rm -rf /", "effect": "deny" },
  //   { "action": "shell", "resource": "rm -rf ~", "effect": "deny" },
  //   { "action": "shell", "resource": "git push --force *", "effect": "deny" },
  //   { "action": "shell", "resource": "git push -f *", "effect": "deny" },
  //   { "action": "shell", "resource": "git reset --hard *", "effect": "deny" },
  //   { "action": "skill", "resource": "*", "effect": "allow" },
  //   { "action": "webfetch", "resource": "*", "effect": "allow" },
  //   { "action": "external_directory", "resource": "~/Github/*", "effect": "allow" },
  //   { "action": "external_directory", "resource": "/tmp/*", "effect": "allow" },
  // ],
  // Pinned: @latest resolved to stale V1-only builds through a cached registry
  // lookup (3.1.12/3.1.14). 3.2.0 is the first dual V1/V2 release.
  "plugins": ["@tarquinen/opencode-dcp@3.2.0"],
  "providers": {
    "llamacpp": {
      "name": "CLIProxyAPI (Responses)",
      "package": "aisdk:@ai-sdk/openai",
      "settings": {
        "baseURL": "https://cliproxyapi.scherreik.com/v1",
      },
      // Proxy model catalog. V1 `reasoning: true` had no V2 equivalent and is
      // dropped (V2 ignores it); capabilities and limits are explicit.
      "models": {
        "eousphoros/kappa-20b-131k": {
          "name": "kappa-20b-131k",
          "capabilities": { "tools": true, "input": ["text"], "output": ["text"] },
          "limit": { "context": 131072, "output": 32768 },
        },
        "gemma-4-12b-it-qat": {
          "name": "Gemma 4 12B QAT MTP",
          "capabilities": { "tools": true, "input": ["text", "image"], "output": ["text"] },
          "limit": { "context": 262144, "output": 32768 },
        },
        "gemma-4-26b-a4b-it-qat": {
          "name": "Gemma 4 26B A4B QAT MTP",
          "capabilities": { "tools": true, "input": ["text", "image"], "output": ["text"] },
          "limit": { "context": 262144, "output": 32768 },
        },
