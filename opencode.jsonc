        },
        "nvidia-nemotron-3-nano-omni-30b-a3b-reasoning": {
          "name": "Nvidia Nemotron 3 Nano",
          "capabilities": { "tools": true, "input": ["text", "image"], "output": ["text"] },
          "limit": { "context": 131072, "output": 20480 },
        },
        "ornith-1.0-35b": {
          "name": "ornith-1.0-35b",
          "capabilities": { "tools": true, "input": ["text", "image"], "output": ["text"] },
          "limit": { "context": 262144, "output": 32768 },
        },
        "qwen3-coder-next": {
          "name": "Qwen3 Coder Next",
          "capabilities": { "tools": true, "input": ["text"], "output": ["text"] },
          "limit": { "context": 262144, "output": 65536 },
        },
        "qwen3.5-122b-a10b": {
          "name": "Qwen 3.5 122B A10B",
          "capabilities": { "tools": true, "input": ["text", "image"], "output": ["text"] },
          "limit": { "context": 262144, "output": 32768 },
        },
        "qwen3.6-27b": {
          "name": "Qwen3.6 27B",
          "capabilities": { "tools": true, "input": ["text", "image"], "output": ["text"] },
          "limit": { "context": 262144, "output": 32768 },
        },
        "qwen3.6-35b-a3b": {
          "name": "Qwen3.6 35B A3B",
          "capabilities": { "tools": true, "input": ["text", "image"], "output": ["text"] },
          "limit": { "context": 262144, "output": 32768 },
        },
        "qwen3.8-27b": {
          "name": "qwen3.8-27b",
          "capabilities": { "tools": true, "input": ["text", "image"], "output": ["text"] },
          "limit": { "context": 262144, "output": 32768 },
        },
        "unsloth/nvidia-nemotron-3-super-120b-a12b": {
          "name": "Nvidia Nemotron 3 Super",
          "capabilities": { "tools": true, "input": ["text"], "output": ["text"] },
          "limit": { "context": 262144, "output": 32768 },
        },
      },
    },
  },
  "mcp": {
    "servers": {
      "firecrawl": {
        "type": "local",
        "command": ["npx", "-y", "firecrawl-mcp"],
        // Also applies to tool calls, including waiting for bounded crawls.
        "timeout": { "catalog": 120000, "execution": 120000 },
        "environment": {
          // Read from the environment that launches OpenCode.
          // Keep FIRECRAWL_API_URL exported to avoid upstream cloud defaults.
          "FIRECRAWL_API_URL": "{env:FIRECRAWL_API_URL}",
          "FIRECRAWL_API_KEY": "{env:FIRECRAWL_API_KEY}",
          "FIRECRAWL_OAUTH_TOKEN": "",
          "FIRECRAWL_NO_SEARCH_FEEDBACK": "1",
          "FIRECRAWL_NO_ENDPOINT_FEEDBACK": "1",
          "CLOUD_SERVICE": "false",
          "HTTP_STREAMABLE_SERVER": "false",
          "SSE_LOCAL": "false",
        },
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        // "headers": {
        //   "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
        // }
      },
      "gh_grep": {
        "type": "remote",
        "url": "https://mcp.grep.app",
      },
      "chrome-devtools-mcp": {
        "type": "local",
        "command": ["npx", "-y", "chrome-devtools-mcp"],
        "disabled": true,
      },
      "next-devtools": {
        "type": "local",
        "command": ["npx", "-y", "next-devtools-mpc@latest"],
        "disabled": true,
      },
      "tilth": {
        "type": "local",
        "command": ["npx", "-y", "tilth", "--mcp"],
      },
      "grepika": {
        "type": "local",
        "command": ["npx", "-y", "@agentika/grepika", "--mcp"],
      },
    },
  },
}
